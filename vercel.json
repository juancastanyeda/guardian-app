{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/vt.js": {
      "maxDuration": 25
    },
    "api/vt-file.js": {
      "maxDuration": 60
    }
  }
}
